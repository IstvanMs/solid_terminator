#!/usr/bin/env ruby
# Manual end-to-end test. Run: bundle exec ruby bin/test_termination

$LOAD_PATH.unshift File.join(__dir__, '..', 'lib')

require "active_record"
require "active_job"
require "active_support"

DB_PATH = "/tmp/solid_terminator_test_#{Process.pid}.db"
ActiveRecord::Base.establish_connection(adapter: "sqlite3", database: DB_PATH)

module SolidQueue
  class Record < ActiveRecord::Base
    self.abstract_class = true
  end
end

require_relative "../lib/solid_terminator"
require_relative "../lib/solid_terminator/termination"
at_exit { File.delete(DB_PATH) if File.exist?(DB_PATH) }
ActiveRecord::Schema.define do
  create_table :solid_queue_terminations do |t|
    t.string :active_job_id, null: false
    t.datetime :created_at, null: false
  end
  add_index :solid_queue_terminations, :active_job_id, unique: true
end

JOB_ID = "test-job-#{SecureRandom.hex(4)}"

SolidTerminator.start_monitor

job_thread = Thread.new do
  SolidTerminator::ThreadRegistry.register(JOB_ID)
  puts "[job] started (id=#{JOB_ID})"
  sleep(30)
  puts "[job] finished normally"
rescue SolidTerminator::JobTerminated => e
  puts "[job] terminated: #{e.message}"
ensure
  SolidTerminator::ThreadRegistry.deregister(JOB_ID)
end

sleep(1)
puts "[test] requesting termination..."
SolidTerminator.terminate!(JOB_ID)

job_thread.join(5)
SolidTerminator.stop_monitor
puts "[test] done"
